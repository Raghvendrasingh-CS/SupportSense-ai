# SupportSense AI — copy to .env and fill in for production
DEMO_MODE=true
PORT=3001
CLIENT_URL=http://localhost:3000
# Optional security key for WebSocket authentication (if demo mode is disabled)
SOCKET_API_KEY=

# Microsoft Graph / Entra ID
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Microsoft Fabric IQ
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=

# OpenAI (optional — uses mock when absent)
# HYBRID MODE: Set DEMO_MODE=true + OPENAI_API_KEY to get real AI reasoning
# while keeping Microsoft API calls mocked. Best for hackathon demos.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI (optional — preferred over standard OpenAI when available)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Microsoft Teams Incoming Webhook (for escalation notifications)
# Create via Teams > Channel > Connectors > Incoming Webhook
TEAMS_WEBHOOK_URL=
