# SupportSense AI — copy to .env and fill in for production
DEMO_MODE=true
PORT=3001
CLIENT_URL=http://localhost:3000

# Microsoft Graph / Entra ID
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Microsoft Fabric IQ
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=

# Work IQ / Copilot
WORK_IQ_ENDPOINT=
WORK_IQ_API_KEY=

# OpenAI (optional — uses mock when absent or DEMO_MODE=true)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
